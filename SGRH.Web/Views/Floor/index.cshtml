@model List<SGRH.Web.Models.FloorModels>

<h1 class="display-4">Floor List</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">➕ Crear Piso</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Número de Piso</th>
            <th>Creado Por</th>
            <th>Fecha de Creación</th>
            <th>Actualizado Por</th>
            <th>Fecha de Actualización</th>
            <th>¿Eliminado?</th>
            <th>Eliminado Por</th>
            <th>Fecha de Eliminación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var piso in Model)
        {
            <tr>
                <td>@piso.Id</td>
                <td>@piso.FloorNumber</td>
                <td>@piso.CreatedBy</td>
                <td>@piso.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@piso.UpdatedBy</td>
                <td>@(piso.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                <td>@(piso.IsDeleted ? "Sí" : "No")</td>
                <td>@(string.IsNullOrEmpty(piso.DeletedBy) ? "-" : piso.DeletedBy)</td>
                <td>@(piso.DeletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@piso.Id">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@piso.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@piso.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
