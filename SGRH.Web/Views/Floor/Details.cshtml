@model SGRH.Web.Models.FloorModels

@{
    ViewData["Title"] = "Detalles del Piso";
}

<h2>@ViewData["Title"]</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Número de Piso</dt>
        <dd class="col-sm-10">@Model.FloorNumber</dd>

        <dt class="col-sm-2">Creado por</dt>
        <dd class="col-sm-10">@Model.CreatedBy</dd>

        <dt class="col-sm-2">Fecha de creación</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToLocalTime()</dd>
    </dl>
</div>

<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
