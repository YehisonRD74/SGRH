
@model SGRH.Web.Models.Floor.FloorEditModels



<h2>Editar Piso</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="FloorNumber"></label>
        <input asp-for="FloorNumber" class="form-control" />
        <span asp-validation-for="FloorNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CreatedBy"></label>
        <input asp-for="CreatedBy" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CreatedAt"></label>
        <input asp-for="CreatedAt" type="datetime-local" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="UpdatedBy"></label>
        <input asp-for="UpdatedBy" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="UpdatedAt"></label>
        <input asp-for="UpdatedAt" type="datetime-local" class="form-control" />
    </div>

    <div class="form-group form-check">
        <input asp-for="IsDeleted" class="form-check-input" />
        <label asp-for="IsDeleted" class="form-check-label"></label>
    </div>

    <div class="form-group">
        <label asp-for="DeletedBy"></label>
        <input asp-for="DeletedBy" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DeletedAt"></label>
        <input asp-for="DeletedAt" type="datetime-local" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
</form>
