@model SGRH.Web.Models.Room.CreateRoomModel

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="NumeroHabitacion" class="control-label"></label>
        <input asp-for="NumeroHabitacion" class="form-control" />
        <span asp-validation-for="NumeroHabitacion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Type" class="control-label"></label>
        <input asp-for="Type" class="form-control" />
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FloorId" class="control-label"></label>
        <input asp-for="FloorId" class="form-control" />
        <span asp-validation-for="FloorId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price" class="control-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <select asp-for="Status" class="form-control">
            <option value="Available">Available</option>
            <option value="Occupied">Occupied</option>
            <option value="Maintenance">Maintenance</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="RoomCategoryId" class="control-label"></label>
        <input asp-for="RoomCategoryId" class="form-control" />
        <span asp-validation-for="RoomCategoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Crear habitación" class="btn btn-primary" />
    </div>
</form>
